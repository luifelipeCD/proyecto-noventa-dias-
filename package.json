{
  "name": "recetario-proteico-90-dias",
  "version": "1.0.0",
  "private": true,
  "description": "Recetario Proteico 90 Días — sitio estático + Cloudflare Worker para generar recetas con IA",
  "scripts": {
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:secret": "wrangler secret put ANTHROPIC_API_KEY --config worker/wrangler.toml",
    "worker:login": "wrangler login"
  },
  "devDependencies": {
    "wrangler": "^4.129.1"
  },
  "allowScripts": {
    "workerd@1.20260907.1": true,
    "esbuild@0.28.1": true
  }
}
